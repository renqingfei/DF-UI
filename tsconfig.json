{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue",
    "packages/*/__tests__/**/*.ts",
    "scripts/**/*.ts",
    "playground/*/src/**/*.ts",
    "playground/*/src/**/*.vue"
  ]
}
